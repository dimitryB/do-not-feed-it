# User-provided judging source documents remain local research material.
research/source-material/

# Creature review captures are large and fully regenerable with
# `node scripts/creature-shots.mjs --iter N`. The log and manifests are kept.
docs/qa/creature/**/*.png

# Gameplay loop review captures are large and fully regenerable with
# `node --experimental-strip-types scripts/loop-shots.mjs --iter N`.
docs/qa/loop/**/*.png
docs/qa/loop/**/*.jpg

# Lore review captures, regenerable with
# `node --experimental-strip-types scripts/lore-shots.mjs --iter N`.
docs/qa/lore/**/*.png

# Aim review captures (stage 6), regenerable with
# `node --experimental-strip-types scripts/aim-shots.mjs --iter N`.
docs/qa/aim/**/*.png
docs/qa/aim/**/*.jpg
