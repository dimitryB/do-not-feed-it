# Browser practice does not require any of these values.
# Scaffold endpoints remain closed even if a contract address is configured.
HEMI_RPC_URL=https://rpc.hemi.network/rpc
HEMI_RPC_FALLBACKS=
DNFI_CONTRACT_ADDRESS=
DNFI_VERIFIER_PRIVATE_KEY=
HEMI_DEPLOYER_PRIVATE_KEY=
# Never use public/client-prefixed names for private keys.
